{
  "name": "agate",
  "private": true,
  "version": "0.2.0",
  "author": "Nathaniel Walser",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "Agate — an unofficial cross-platform desktop client for Bitwarden, built with Tauri 2 and SolidJS.",
  "scripts": {
    "dev": "tauri dev",
    "tauri": "tauri",
    "build": "tauri build",
    "vite:build": "vite build",
    "vite:dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tests/e2e --noEmit",
    "lint": "eslint .",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e:build": "tauri build --debug --no-bundle",
    "test:e2e": "node scripts/e2e-serial.mjs",
    "test:e2e:wdio": "wdio run ./tests/e2e/wdio.conf.ts",
    "test:e2e:spec": "wdio run ./tests/e2e/wdio.conf.ts --spec",
    "test:e2e:all": "npm run test:e2e:build && npm run test:e2e",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/chai": "^5.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@wdio/cli": "^9.4.4",
    "@wdio/globals": "^9.4.4",
    "@wdio/local-runner": "^9.4.4",
    "@wdio/mocha-framework": "^9.4.4",
    "@wdio/spec-reporter": "^9.4.4",
    "chai": "^5.1.2",
    "eslint": "^9.17.0",
    "expect-webdriverio": "^5.0.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "mocha": "^11.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^2.1.8",
    "webdriverio": "^9.4.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "lucide-solid": "^0.469.0",
    "solid-js": "^1.9.3"
  }
}
